<mujoco model="fr3 actuators (velocity)">
  <!-- Velocity control: arm joints driven by MuJoCo velocity servos.
       Used when control_mode:=velocity. kv gains reused from actuators_position.xml's
       per-joint velocity-damping gains. -->
  <actuator>
    <velocity class="fr3" name="fr3_joint1" joint="fr3_joint1" kv="450"/>
    <velocity class="fr3" name="fr3_joint2" joint="fr3_joint2" kv="450"/>
    <velocity class="fr3" name="fr3_joint3" joint="fr3_joint3" kv="350"/>
    <velocity class="fr3" name="fr3_joint4" joint="fr3_joint4" kv="350"/>
    <velocity class="fr3" name="fr3_joint5" joint="fr3_joint5" kv="200"/>
    <velocity class="fr3" name="fr3_joint6" joint="fr3_joint6" kv="200"/>
    <velocity class="fr3" name="fr3_joint7" joint="fr3_joint7" kv="200"/>
    <position class="fr3" name="fr3_finger_joint1" tendon="split" kp="300" kv="30" inheritrange="0" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
