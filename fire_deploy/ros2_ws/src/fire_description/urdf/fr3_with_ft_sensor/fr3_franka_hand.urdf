      <mass value="0.6544"/>
      <inertia ixx="0.00186" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="-2e-05" izz="0.00174"/>
    </inertial>
  </link>
  <link name="fr3_hand_sc">
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.04"/>
